# WEBBUILD de python — CPython 3 complet (interpréteur + bibliothèque standard) pour webOS (M3.5c, décision D-PYTHON).
# Construit deux fois : un CPython pour la MACHINE de construction (exigé par la compilation croisée : il exécute les outils de CPython
# et précompile la bibliothèque), puis CPython pour webOS (webos-cc, cible wasm32-wasi, tout lié dans un seul programme).
# Lancer des programmes : par posix_spawn (correctif 0002, `subprocess`, `os.popen`, `os.system`) ; os.fork() n'existe pas (spike S10).
# Source : python.org (archive identique à l'archive d'origine de Debian, même SHA-256).
pkgname=python
pkgver=3.13.18
pkgrel=2
_pyver=3.13
_zlib=1.3.1
pkgdesc="langage Python 3 (CPython) avec sa bibliothèque standard"
url="https://www.python.org/"
license=('PSF-2.0' 'Zlib')
arch=wasm32
tier=system
provides=("python3=${pkgver}")
embeds=("zlib=${_zlib}")
source=("https://www.python.org/ftp/python/${pkgver}/Python-${pkgver}.tar.xz"
        "https://zlib.net/fossils/zlib-${_zlib}.tar.gz"
        'patches/0001-socket-sans-gethostbyname.patch'
        'patches/0002-subprocess-posix-spawn.patch')
sha256sums=('abb0102e6d4ae027509bcb82327d9dd85515b44a3ba8ad538cfc5e9847029f68'
            '9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23'
            'fb13911d7850bea6dbad6b3827e4b60ea8a7eaee54b995efb39e06b9b9b20593'
            'cf49da887a41a389ce8b6ccb17e128c3ba10c9acc195c4d997ac6908e486592a')

# Fonctions que wasi-libc DÉCLARE sans les fournir (le configure de CPython ne fait souvent que compiler, sans lier), en-têtes de la
# machine de construction vus à tort, et ce que webOS n'a pas (epoll, timerfd, eventfd, memfd, DNS, utmp, setrlimit…).
_cache=(ac_cv_file__dev_ptmx=no ac_cv_file__dev_ptc=no ac_cv_func_mmap_fixed_mapped=no
  ac_cv_header_lzma_h=no ac_cv_header_bzlib_h=no ac_cv_header_netpacket_packet_h=no
  ac_cv_buggy_getaddrinfo=no ac_cv_header_sys_resource_h=no ac_cv_header_utmp_h=no ac_cv_have_decl_UT_NAMESIZE=no
  ac_cv_func_epoll=no ac_cv_func_epoll_create=no ac_cv_func_epoll_create1=no ac_cv_header_sys_epoll_h=no
  ac_cv_func_timerfd_create=no ac_cv_header_sys_timerfd_h=no ac_cv_header_sys_eventfd_h=no ac_cv_func_eventfd=no
  ac_cv_func_memfd_create=no ac_cv_header_sys_memfd_h=no ac_cv_func_setgroups=no
  ac_cv_func_gethostbyname=no ac_cv_func_gethostbyaddr=no ac_cv_func_gethostbyname_r=no ac_cv_func_getservbyname=no
  ac_cv_func_getservbyport=no ac_cv_func_getprotobyname=no ac_cv_func_getnameinfo=no
  ac_cv_header_libintl_h=no ac_cv_func_bind_textdomain_codeset=no)

prepare() {
  cp -a "Python-$pkgver" native
  cd "Python-$pkgver"
  for p in "$srcdir"/0*.patch; do patch -p1 < "$p"; done
}

build() {
  # 1. CPython pour la machine de construction (même version)
  (cd native && ./configure --prefix="$srcdir/native-install" --without-ensurepip && make -j"$(nproc)" && make install)
  local hostpy="$srcdir/native-install/bin/python3"

  # 2. zlib (compression : zlib, gzip, zipfile, binascii.crc32…), bibliothèque statique liée dans python
  local zst="$srcdir/zlib-stage"
  (cd "zlib-${_zlib}" && CC=webos-cc AR=webos-ar CFLAGS="-Oz" CHOST=wasm32 ./configure --static --prefix=/usr && make libz.a)
  install -Dm644 "zlib-${_zlib}/zlib.h" "$zst/include/zlib.h"
  install -Dm644 "zlib-${_zlib}/zconf.h" "$zst/include/zconf.h"
  install -Dm644 "zlib-${_zlib}/libz.a" "$zst/lib/libz.a"

  # 3. CPython pour webOS. SOCK_RAW : absent de wasi-libc. Les constantes CLOCK_* sont des pointeurs sous WASI : convertis en entier
  #    et retour sans perte en 32 bits (-Wno-error=int-conversion).
  cd "Python-$pkgver"
  ZLIB_CFLAGS="-I$zst/include" ZLIB_LIBS="-L$zst/lib -lz" PKG_CONFIG=false CONFIG_SITE=/w/toolchain/autoconf/config.site WEBOS_CC_CONFIGURE=1 CC=webos-cc CFLAGS="-Oz -D_GNU_SOURCE -DSOCK_RAW=3" \
    ./configure --host=wasm32-wasi --build=x86_64-linux-gnu --with-build-python="$hostpy" --prefix=/usr \
      --disable-test-modules --without-ensurepip --disable-ipv6 --without-readline "${_cache[@]}"
  # l'éditeur de liens de Zig refuse --stack-first ; même taille de pile et de mémoire initiale que la cible WASI de CPython
  sed -i 's/^CONFIGURE_LDFLAGS_NODIST=.*/CONFIGURE_LDFLAGS_NODIST= -Wl,-z,stack-size=8388608 -Wl,--initial-memory=20971520/' Makefile
  make -j"$(nproc)" CFLAGS_NODIST="-Wno-error=int-conversion"
}

package() {
  local hostpy="$srcdir/native-install/bin/python3"
  cd "Python-$pkgver"
  make install DESTDIR="$pkgdir" CFLAGS_NODIST="-Wno-error=int-conversion" >/dev/null
  local lib="$pkgdir/usr/lib/python${_pyver}"
  # allégé : tests, IDLE, Tkinter (pas d'affichage graphique), ensurepip (pas de réseau pip), bibliothèque statique de CPython
  rm -rf "$lib/test" "$lib"/*/test "$lib"/*/tests "$lib/idlelib" "$lib/tkinter" "$lib/turtledemo" "$lib/ensurepip" \
    "$lib"/config-"${_pyver}"-* "$pkgdir/usr/bin"/idle3* "$pkgdir/usr/bin"/python3*-config "$pkgdir/usr/include" \
    "$pkgdir/usr/lib/pkgconfig" "$pkgdir/usr/lib/libpython"*
  find "$pkgdir" -name __pycache__ -type d -prune -exec rm -rf {} +
  mkdir -p "$lib/lib-dynload"   # attendu par CPython (sinon un avertissement à chaque lancement), vide : tout est lié dans le programme
  : > "$lib/lib-dynload/.webos"
  # bibliothèque précompilée une fois pour toutes (sinon Python écrirait ses .pyc dans /usr au premier lancement) ; « unchecked-hash » :
  # pas de date dans les .pyc (reproductible)
  "$hostpy" -m compileall -q -j1 --invalidation-mode unchecked-hash -d "/usr/lib/python${_pyver}" "$lib"
  # le programme : python3.13, et les noms courants
  mv "$pkgdir/usr/bin/python${_pyver}.wasm" "$pkgdir/usr/bin/python${_pyver}"
  rm -f "$pkgdir/usr/bin/python3.wasm"
  ln -s "python${_pyver}" "$pkgdir/usr/bin/python3"
  ln -s python3 "$pkgdir/usr/bin/python"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/python/LICENSE"
  install -Dm644 "$srcdir/zlib-${_zlib}/LICENSE" "$pkgdir/usr/share/licenses/python/zlib-LICENSE"
  # page de manuel : python3.13.1 et le lien python3.1 sont posés par make install
}
